# Control
KOORDYNATOR_CONTROL_HOST=127.0.0.1
KOORDYNATOR_CONTROL_PORT=8787
KOORDYNATOR_STATE_DIR=.orchestrator
KOORDYNATOR_CONTROL_TOKEN=
KOORDYNATOR_VERSION=0.4.0

# Live Chat / OmniRoute — klucz tylko w procesie serwera
OMNIROUTE_ENDPOINT=http://127.0.0.1:20128/v1
# Leave blank on macOS to load from Keychain service `hermes-omniroute-api-key`.
OMNIROUTE_API_KEY=
# Exact route/combo from `npm run doctor:omniroute`; a "free" name is not price evidence.
KOORDYNATOR_CHAT_MODEL=gc/grok-4.6
# Optional exact protected OAuth/subscription routes listed by doctor.
# Provider keys/OAuth sessions stay in OmniRoute. This file uses the gateway key only.
# `npm run ai:always-on` / `ai:bootstrap` fills these from live probes.
# Priority: free OAuth first, then subscription harness; Codex/OpenAI last.
KOORDYNATOR_OPENAI_MODEL=
KOORDYNATOR_ANTHROPIC_MODEL=
KOORDYNATOR_GITHUB_COPILOT_MODEL=
KOORDYNATOR_GROK_MODEL=
KOORDYNATOR_GEMINI_MODEL=
KOORDYNATOR_KIRO_MODEL=
KOORDYNATOR_QODER_MODEL=
KOORDYNATOR_QWEN_MODEL=
KOORDYNATOR_KIMI_MODEL=
KOORDYNATOR_CURSOR_MODEL=
KOORDYNATOR_KILOCODE_MODEL=
KOORDYNATOR_CLINE_MODEL=
KOORDYNATOR_AMAZON_Q_MODEL=
KOORDYNATOR_ANTIGRAVITY_MODEL=
KOORDYNATOR_ASTRA_MODEL=
# Comma-separated OmniRoute routes used as Hermes fallback_providers (same gateway).
KOORDYNATOR_FALLBACK_MODELS=gc/grok-4.6,cx/gpt-5.5,cx/gpt-5.6-sol
KOORDYNATOR_CHAT_GITHUB_CONTEXT=1
# Inject bounded local workspace files when the user asks about lokalne repo/pliki/src.
KOORDYNATOR_CHAT_WORKSPACE_CONTEXT=1
# Optional absolute project root for Live Chat workspace reads (defaults to process.cwd()).
# KOORDYNATOR_PROJECT_ROOT=
# Explicit /repo URL task execution through local Hermes (same OS user as gh/git).
KOORDYNATOR_CHAT_REPO_EXECUTION=0
